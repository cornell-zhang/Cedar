; SPDX-License-Identifier: Apache-2.0
; Commutativity of binary addition: a+b ==> b+a (exact for any width).
(rule
    ((= ?lhs (comb_add ?a ?ops ?t))
     (= 1 (vec-length ?ops))
     (= ?b (vec-get ?ops 0)))
    ((let s (comb_add ?b (vec-push (vec-empty) ?a) ?t))
     (union ?lhs s))
    :ruleset rules)
